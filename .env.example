# Elysia Assistant — Environment Configuration Template
# Salin file ini menjadi .env dan isi API keys Anda.

# --- Google AI Studio API Key (Wajib untuk Gemini LLM) ---
GOOGLE_API_KEY=AIzaSy...

# --- Picovoice Access Key (Opsional / Free Tier untuk custom wake word Porcupine) ---
PICOVOICE_ACCESS_KEY=

# --- Wake Word ---
# Engine: openwakeword (default, offline, tanpa key) atau porcupine (butuh key + file .ppn)
WAKE_WORD_ENGINE=openwakeword
# Model openwakeword bawaan: hey_jarvis (frasa "Hey Jarvis"), alexa, hey_mycroft, timer, weather
OPENWAKEWORD_MODEL=hey_jarvis
# Opsional: path ke model openwakeword custom (mis. hey_elysia.onnx).
# Jika diisi, ini mengalahkan OPENWAKEWORD_MODEL. Inilah cara memakai frasa "Hei Elysia".
OPENWAKEWORD_MODEL_PATH=

# --- Audio Settings ---
# Pilihan: mic (default), speaker (PipeWire loopback), headset
AUDIO_INPUT_SOURCE=mic
SAMPLE_RATE=16000
VAD_SILENCE_THRESHOLD_MS=800
VAD_MAX_RECORD_MS=15000
# Jendela tunggu (ms) agar user mulai bicara setelah wake word / prompt konfirmasi
VAD_NO_SPEECH_GRACE_MS=5000
# Abaikan ekor wake word selama N ms pertama agar rekaman tidak terputus terlalu dini
VAD_START_IGNORE_MS=500
# Ambang probabilitas Silero VAD (0.1-0.9) untuk menganggap frame sebagai speech
VAD_THRESHOLD=0.5
# Pin ref torch.hub Silero VAD (mis. tag rilis) agar tidak mengikuti master; kosong = master
SILERO_VAD_HUB_REF=
COOLDOWN_SEC=2.0
CONFIRMATION_TIMEOUT_SEC=5.0
# Batas tunggu (detik) jawaban "ada perintah lain?" sebelum sesi diakhiri
FOLLOWUP_TIMEOUT_SEC=5.0

# --- Speech-to-Text (STT) Model ---
# Pilihan model: tiny, base, small (default), medium, large-v3
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Batas waktu transkripsi (ms) sebelum dianggap gagal/timeout
STT_TIMEOUT_MS=2500
# RMS minimum (0-1). Di bawah ini dianggap sunyi -> tidak dikirim ke Whisper (cegah halusinasi)
STT_MIN_RMS=0.01

# --- Text-to-Speech (TTS) ---
# Pilihan: edge (online default), piper (offline fallback)
TTS_PROVIDER_DEFAULT=edge
TTS_VOICE_EDGE=id-ID-GadisNeural
TTS_VOICE_PIPER=id_ID-news_tts-medium
# Timeout Edge TTS (detik) per percobaan; retry 1x sebelum fallback ke Piper
TTS_EDGE_TIMEOUT_SEC=5.0

# --- Gemini Model ---
# Pakai nama model yang tersedia untuk API key Anda (mis. gemini-flash-latest,
# gemini-2.0-flash). Bila tidak tersedia, Elysia mencoba fallback otomatis.
GEMINI_MODEL=gemini-flash-latest
LLM_REQUEST_TIMEOUT_MS=3500

# --- Logging & Debug ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# True: simpan audio gagal ke folder .debug_audio/ (opt-in privacy)
DEBUG_RECORD_AUDIO=false
